generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model MediaClient {
  id        String        @id @default(uuid())
  name      String        @unique
  taxNumber String?       // السجل الضريبي للعميل
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  records   MediaRecord[]

  @@map("media_clients")
}

model MediaSupplier {
  id        String        @id @default(uuid())
  name      String        @unique
  taxNumber String?       // السجل الضريبي للمورد
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  records   MediaRecord[]

  @@map("media_suppliers")
}

model MediaChannel {
  id        String        @id @default(uuid())
  name      String        @unique
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  records   MediaRecord[]

  @@map("media_channels")
}

model MediaContentType {
  id        String         @id @default(uuid())
  name      String         @unique
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  contents  MediaContent[]

  @@map("media_content_types")
}

model MediaContent {
  id            String           @id @default(uuid())
  name          String
  contentTypeId String
  contentType   MediaContentType @relation(fields: [contentTypeId], references: [id], onDelete: Cascade)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  records       MediaRecord[]

  @@map("media_contents")
}

model MediaRecord {
  id          String        @id @default(uuid())
  title       String?
  clientId    String
  client      MediaClient   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  supplierId  String
  supplier    MediaSupplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  channelId   String
  channel     MediaChannel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  contentId   String
  content     MediaContent  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  month        String        // e.g. "يناير 2026", "2026-01"
  cost         Decimal       @default(0.00) @db.Decimal(12, 2)
  netToChannel Decimal       @default(0.00) @db.Decimal(12, 2)
  netToClient  Decimal       @default(0.00) @db.Decimal(12, 2)
  notes        String?
  status      String        @default("PLANNED") // PLANNED, ACTIVE, COMPLETED, INVOICED
  invoiceId   String?       // Connected to accounting invoice ID
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("media_records")
}
