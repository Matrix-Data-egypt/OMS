generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  FINANCE_MANAGER
  ACCOUNTANT
  SALES
}

enum InvoiceStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  ISSUED
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentMethod {
  BANK_TRANSFER
  CASH
  CHEQUE
  ONLINE
}

enum DeliveryChannel {
  PDF
  EMAIL
  WHATSAPP
}

enum DeliveryStatus {
  PENDING
  SUCCESS
  FAILED
}

model User {
  id              String         @id @default(uuid())
  email           String         @unique
  username        String?        @unique
  passwordHash    String
  name            String
  role            UserRole       @default(ACCOUNTANT)
  systemAccess    String         @default("INVOICE") // "INVOICE", "MEDIA", "ALL"
  phone           String?
  isActive        Boolean        @default(true)
  createdInvoices Invoice[]      @relation("CreatedByUser")
  approvals       ApprovalStep[] @relation("ApproverUser")
  payments        Payment[]      @relation("RecordedByUser")
  auditLogs       AuditLog[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@map("users")
}

model Client {
  id             String    @id @default(uuid())
  name           String
  companyName    String?
  email          String?
  phone          String?
  whatsappNumber String?
  taxNumber      String?
  address        String?
  notes          String?
  isActive       Boolean   @default(true)
  invoices       Invoice[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("clients")
}

model Service {
  id             String        @id @default(uuid())
  nameAr         String
  nameEn         String
  description    String?
  defaultPrice   Decimal       @db.Decimal(12, 2)
  defaultTaxRate Decimal       @default(14.00) @db.Decimal(5, 2) // VAT 14%
  isActive       Boolean       @default(true)
  invoiceItems   InvoiceItem[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@map("services")
}

model ApprovalRule {
  id           String         @id @default(uuid())
  levelOrder   Int            @unique // 1, 2, 3...
  minAmount    Decimal        @db.Decimal(12, 2)
  maxAmount    Decimal        @db.Decimal(12, 2)
  requiredRole UserRole
  description  String?
  isActive     Boolean        @default(true)
  steps        ApprovalStep[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@map("approval_rules")
}

model Invoice {
  id               String        @id @default(uuid())
  invoiceNumber    String        @unique
  clientId         String
  client           Client        @relation(fields: [clientId], references: [id])
  createdById      String
  createdBy        User          @relation("CreatedByUser", fields: [createdById], references: [id])
  status           InvoiceStatus @default(DRAFT)
  issueDate        DateTime      @default(now())
  dueDate          DateTime
  subtotal         Decimal       @default(0.00) @db.Decimal(12, 2)
  discountAmount   Decimal       @default(0.00) @db.Decimal(12, 2)
  taxAmount        Decimal       @default(0.00) @db.Decimal(12, 2)
  totalAmount      Decimal       @default(0.00) @db.Decimal(12, 2)
  paidAmount       Decimal       @default(0.00) @db.Decimal(12, 2)
  remainingBalance Decimal       @default(0.00) @db.Decimal(12, 2)
  currency         String        @default("EGP")
  notes            String?
  terms            String?

  items         InvoiceItem[]
  taxes         InvoiceTax[]
  approvalSteps ApprovalStep[]
  payments      Payment[]
  deliveryLogs  DeliveryLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("invoices")
}

model InvoiceItem {
  id          String   @id @default(uuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  serviceId   String?
  service     Service? @relation(fields: [serviceId], references: [id])
  description String
  quantity    Decimal  @default(1.00) @db.Decimal(10, 2)
  unitPrice   Decimal  @db.Decimal(12, 2)
  discount    Decimal  @default(0.00) @db.Decimal(12, 2)
  total       Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())

  @@map("invoice_items")
}

model InvoiceTax {
  id            String   @id @default(uuid())
  invoiceId     String
  invoice       Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  taxName       String // e.g. "VAT 14%" or "WHT 1%"
  taxRate       Decimal  @db.Decimal(5, 2)
  taxAmount     Decimal  @db.Decimal(12, 2)
  isWithholding Boolean  @default(false) // true if deducted like ضريبة خصم 1%
  createdAt     DateTime @default(now())

  @@map("invoice_taxes")
}

model ApprovalStep {
  id         String         @id @default(uuid())
  invoiceId  String
  invoice    Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  ruleId     String?
  rule       ApprovalRule?  @relation(fields: [ruleId], references: [id])
  levelOrder Int
  approverId String?
  approver   User?          @relation("ApproverUser", fields: [approverId], references: [id])
  status     ApprovalStatus @default(PENDING)
  comments   String?
  actionDate DateTime?
  createdAt  DateTime       @default(now())

  @@map("approval_steps")
}

model Payment {
  id              String        @id @default(uuid())
  invoiceId       String
  invoice         Invoice       @relation(fields: [invoiceId], references: [id])
  amount          Decimal       @db.Decimal(12, 2)
  paymentMethod   PaymentMethod @default(BANK_TRANSFER)
  paymentDate     DateTime      @default(now())
  referenceNumber String?
  notes           String?
  recordedById    String
  recordedBy      User          @relation("RecordedByUser", fields: [recordedById], references: [id])
  createdAt       DateTime      @default(now())

  @@map("payments")
}

model DeliveryLog {
  id           String          @id @default(uuid())
  invoiceId    String
  invoice      Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  channel      DeliveryChannel
  recipient    String
  status       DeliveryStatus  @default(PENDING)
  errorMessage String?
  retryCount   Int             @default(0)
  sentAt       DateTime?
  createdAt    DateTime        @default(now())

  @@map("delivery_logs")
}

model AuditLog {
  id            String   @id @default(uuid())
  entity        String
  entityId      String
  action        String // CREATE, UPDATE, APPROVE, REJECT, CANCEL, VOID_APPROVAL, etc.
  performedById String?
  performedBy   User?    @relation(fields: [performedById], references: [id])
  details       String?  @db.Text
  ipAddress     String?
  createdAt     DateTime @default(now())

  @@map("audit_logs")
}
